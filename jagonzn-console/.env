# 【通用】环境变量
#
# ⚠️ VITE_ 前缀的变量会被 Vite **原样内联进客户端产物**，任何人打开浏览器
#    devtools 都能看到。这里绝不能放密钥、令牌或任何生产端点凭据。
#    需要保密的值只能放在后端。

# 前端存储结构版本。它只用于 localStorage 键名前缀，避免沿用后台模板的 v3.0.2。
VITE_VERSION = 0.1.0

# 开发服务器端口
VITE_PORT = 13006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
#
# 已切到 backend（S1 切片 3）。菜单树与按钮权限点由 /api/v1/system/menus 下发
# （架构文档 11.2），前端只做渲染，权限点命名遵循 7.2 的 resource:action。
#
# 切到 backend 后，src/router/modules/ 下那份静态路由**只在 frontend 模式下生效**，
# 相当于后端不可用时的兜底。两份靠人工保持一致，加菜单时两边都要改 ——
# 不一致的症状很隐蔽：日常看不出来，只有切回兜底时才发现菜单少了几项。
#
# 切换时最容易漏的一步：**切换项目必须重新拉取权限集合** —— 同一账号在项目 A
# 是 OWNER、在项目 B 是 VIEWER 是完全正常的情况。当前令牌绑定单一租户，
# 换租户即重新登录，所以还不会踩到；引入项目切换器时必须重新处理。
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie。
#
# 已置 true（S1 切片 4）：刷新令牌走 HttpOnly Cookie（ADR 0010），跨源时必须
# 显式允许携带凭据，否则刷新接口拿不到 Cookie。
#
# 它与后端 things-cloud.security.session.allowed-origins 是**成对**的：
# 一边开了另一边没开，表现是「开发环境好好的，上线后登录态时灵时不灵」
# （架构文档 11.2 点名不能一边改一边猜）。
#
# 开发环境走 Vite 代理，实际是同源请求，这个开关此时不起作用；
# 真正会用到它的是跨源部署 —— 而 ADR 0010 要求控制台与 API 同站，
# 所以正常情况下后端那份 allowed-origins 应当保持为空。
VITE_WITH_CREDENTIALS = true

# 是否在控制台打印路由信息，排查路由问题时打开
VITE_OPEN_ROUTE_INFO = false
