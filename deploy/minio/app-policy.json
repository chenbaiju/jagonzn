{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads",
        "s3:GetBucketVersioning", "s3:GetBucketPolicy", "s3:ListBucketVersions"],
      "Resource": [
        "arn:aws:s3:::firmware", "arn:aws:s3:::device-image",
        "arn:aws:s3:::export", "arn:aws:s3:::backup", "arn:aws:s3:::jagonzn-ota"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject",
        "s3:DeleteObject", "s3:DeleteObjectVersion",
        "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::firmware/*", "arn:aws:s3:::device-image/*",
        "arn:aws:s3:::export/*", "arn:aws:s3:::backup/*", "arn:aws:s3:::jagonzn-ota/*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": ["s3:*"],
      "NotResource": [
        "arn:aws:s3:::firmware", "arn:aws:s3:::device-image",
        "arn:aws:s3:::export", "arn:aws:s3:::backup", "arn:aws:s3:::jagonzn-ota",
        "arn:aws:s3:::firmware/*", "arn:aws:s3:::device-image/*",
        "arn:aws:s3:::export/*", "arn:aws:s3:::backup/*", "arn:aws:s3:::jagonzn-ota/*"
      ]
    },
    {"Effect": "Deny", "Action": ["admin:*"], "Resource": ["*"]}
  ]
}
