.vscode/
*.iml

# Local environment and generated files
.env
.env.local
__pycache__/
*.pyc

# 本机外设映射、构建缓存及测试原件；不随独立源码仓库提交。
/.private/
/.mvn/maven.config
/jagonzn-service/.mvn/maven.config
